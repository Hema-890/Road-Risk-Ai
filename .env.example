# ==============================================================================
# ROADRISK AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or .env.local and populate with your credentials.
# Do NOT commit real secret values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client-Side)
# ------------------------------------------------------------------------------

# Operational Data Mode: 'auto' | 'cloud' | 'local'
# - auto: Connects to Supabase if configured, otherwise falls back to local SQLite
# - cloud: Supabase is strict source of truth (fails explicitly if unconfigured)
# - local: Local SQLite database is authoritative
VITE_DATA_MODE=auto

# Supabase Public Client Credentials (Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase Cloud Messaging & Web Push (Frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# MapLibre & Vector Tiles
VITE_MAP_PROVIDER=vector
VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=your-maptiler-api-key-here
VITE_MAPTILER_KEY=your-maptiler-api-key-here
VITE_MAPTILER_API_KEY=your-maptiler-api-key-here

# Routing & Geocoding
VITE_OSRM_BASE_URL=https://router.project-osrm.org
VITE_BACKEND_API_URL=http://localhost:3001
VITE_TELEMETRY_BROADCAST_INTERVAL_MS=1000

# Real-Time Live Traffic Provider (TomTom Traffic API)
# Get a free key with 2,500 free daily requests at https://developer.tomtom.com
VITE_TRAFFIC_PROVIDER=tomtom
VITE_TRAFFIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. BACKEND & SERVER SECRETS (Node.js Server Only — NEVER Expose to Client)
# ------------------------------------------------------------------------------

PORT=3001

# Supabase Admin / Service Role Secret Key (Server-side bypass for migrations/audit)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Firebase Admin SDK Credentials (Server-side FCM push multicast)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Periodic Telemetry Persistence Interval (Milliseconds)
TELEMETRY_PERSIST_INTERVAL_MS=5000

# External Optional AI Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
